# ==============================================================================
# Git Ignore Configuration - AI-Powered Cloud Cost & Resource Optimizer Platform
# ==============================================================================

# Python bytecode & caching
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment files (exclude live secrets, keep example template)
.env
.env.local
.env.production
!.env.example

# IDEs & Text Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Database files & local volume mounts
*.db
*.sqlite3
pgdata/

# Machine Learning models & scalers
# General rule: ignore arbitrary large training dumps, but explicitly KEEP
# pre-trained models in ml/models/ so the repository works out of the box on any machine.
*.joblib
*.pkl
*.h5
!ml/models/*.joblib
!ml/models/*.pkl
!ml/models/*.json
!ml/models/.gitkeep

# Experiment results
# Ignore individual test/simulation run artifacts, but KEEP aggregated demo data
experiments/results/exp_*.json
!experiments/results/all_experiments.json

# Docker & Containerization
docker-compose.override.yml

# Kubernetes & Helm
*.kubeconfig

# Secrets & certificates
secrets/
*.pem
*.key
*.crt
*.p12

# Build artifacts
*.tar.gz
*.whl

# Logs & temp files
*.log
logs/

# Testing, QA & Coverage
.coverage
htmlcov/
coverage.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints/

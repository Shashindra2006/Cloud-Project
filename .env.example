# AI-Powered Cloud Cost & Resource Optimization Platform
# Environment Variables Configuration
# Copy this file to .env and fill in actual values

# Database
DATABASE_URL=postgresql://cloudopt:cloudopt_pass@localhost:5432/cloudopt
POSTGRES_USER=cloudopt
POSTGRES_PASSWORD=cloudopt_pass
POSTGRES_DB=cloudopt
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# Workload Simulator
WORKLOAD_HOST=0.0.0.0
WORKLOAD_PORT=8080

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# ML Configuration
ML_MODEL_PATH=ml/models
ML_TRAINING_INTERVAL=300
ML_PREDICTION_HORIZON=5
ML_MIN_TRAINING_SAMPLES=50

# Optimizer
OPTIMIZER_DRY_RUN=true
OPTIMIZER_MIN_REPLICAS=1
OPTIMIZER_MAX_REPLICAS=10
OPTIMIZER_COOLDOWN_SECONDS=120
OPTIMIZER_SAFETY_MARGIN=0.2

# Cost Model (per hour)
COST_CPU_PER_CORE_HOUR=0.048
COST_MEMORY_PER_GB_HOUR=0.006
COST_BASE_INSTANCE_HOUR=0.0116
